{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cordis": ["E:/code/deepseek-harness/vendor/cordis/src"],
      "@deepseek-ai/cosmokit": ["E:/code/deepseek-harness/vendor/cosmokit/src"],
      "@deepseek-ai/schemastery": ["E:/code/deepseek-harness/vendor/schemastery/src"],
      "@deepseek-ai/cordis-plugin-loader": ["E:/code/deepseek-harness/vendor/loader/src"],
      "@deepseek-ai/cordis-plugin-include": ["E:/code/deepseek-harness/vendor/include/src"],
      "@deepseek-ai/dsh-host-webserver": ["E:/code/deepseek-harness/packages/host/webserver/src"],
      "@deepseek-ai/dsh-host-frontend-static": ["E:/code/deepseek-harness/packages/host/frontend-static/src"],
      "@deepseek-ai/dsh-credentials": ["E:/code/deepseek-harness/packages/credentials/credentials/src"],
      "@deepseek-ai/dsh-settings": ["E:/code/deepseek-harness/packages/settings/settings/src"],
      "@deepseek-ai/dsh-invariants": ["E:/code/deepseek-harness/packages/runtime-diagnostics/invariants/src"]
    }
  },
  "include": ["src", "tests"]
}
