{
  "name": "@islibaodong/dsh-login",
  "description": "Multi-user authentication gateway plugin for the DSH Web GUI",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./connection": "./src/connection.ts",
    "./connection-client": "./src/connection.client.ts",
    "./client": "./dist/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:client": "node scripts/build-client.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["slots", "locale"],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0",
    "@deepseek-ai/dsh-credentials": ">=0.1.0",
    "@deepseek-ai/dsh-host-frontend-static": ">=0.1.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.0",
    "@deepseek-ai/schemastery": ">=0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild-wasm": "^0.28.2",
    "tsx": "^4.23.12",
    "vitest": "^2.1.9"
  }
}
